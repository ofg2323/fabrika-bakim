# Docker kurulumu için örnek ortam dosyası.
# Kullanım: cp .env.docker.example .env  (ve değerleri değiştirin)

POSTGRES_DB=fabrika_bakim
POSTGRES_USER=fabrika_user
# Yalnızca harf ve rakam kullanın (URL içinde özel karakter sorun çıkarır).
POSTGRES_PASSWORD=bu-sifreyi-degistirin

# En az 32 karakterlik rastgele bir değer üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=bu-anahtari-degistirin

# Dışarıya açılacak port
APP_PORT=3001

# Tarayıcıdan erişilen adres (alan adı veya sunucu IP'si)
CORS_ORIGIN=http://localhost:3001

# Yedeklerin saklanma süresi (gün)
RETENTION_DAYS=30
